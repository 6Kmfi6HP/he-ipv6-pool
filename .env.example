# 复制为 .env 后填写。.env 里有代理密码，不要提交到 git。

# HE 隧道详情页（https://tunnelbroker.net）上的信息
# Server IPv4 Address，例如 216.66.80.26
HE_SERVER=
# Routed /64 和 Routed /48，逗号分隔，例如 2001:db8:1::/64,2001:db8:abcd::/48
HE_PREFIXES=
# 本地绑定的 IPv4：1:1 NAT 的云主机留空，家用路由器后面可以填内网 IP
HE_LOCAL=
# 与 HE 后台 Advanced 页的 MTU 一致
HE_MTU=1480

# 代理监听地址，SOCKS5 和 HTTP 共用；建议用不常见的高位端口
PROXY_LISTEN=:24601
PROXY_USER=
# 用 openssl rand -hex 16 生成；不能含 : @ / 和空格
PROXY_PASS=

# 镜像版本，默认 latest；可以固定为 0.3.0 这样的版本号
# IMAGE_TAG=latest
